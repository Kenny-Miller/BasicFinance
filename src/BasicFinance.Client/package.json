{
  "name": "basic-finance.client",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "start:win32": "ng serve --port %PORT%",
    "start:default": "ng serve --port $PORT",
    "start-standalone": "ng serve --port 4200",
    "build": "ng build",
    "postbuild": "npx tsx scripts/generate-environment-config.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false --coverage",
    "test:e2e": "vp test run --config vitest.e2e.ts",
    "gen:api": "npx openapi-ts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.0.2",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@googleworkspace/drive-picker-element": "^0.7.3",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "^1.1.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/google.picker": "^0.0.52",
    "angular-oauth2-oidc": "^20.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "ng2-charts": "^8.0.0",
    "ngx-echarts": "^21.0.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@spartan-ng/cli": "^1.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.19.1",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "happy-dom": "^20.10.6",
    "run-script-os": "^1.1.6",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "playwright": "*",
    "vite-plus": "1.2.0"
  },
  "packageManager": "npm@12.2.0",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "nx@23.3.0": true
  }
}
